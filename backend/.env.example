# ============================================================
#  BACKEND — Variables de entorno para Railway
#  Cargá estas variables en: Railway → Backend Service → Variables
#  ⚠️  NUNCA pongas valores reales aquí. Este archivo va al repositorio.
# ============================================================

# Base de datos (Neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Email (Gmail con App Password — generarla en myaccount.google.com/apppasswords)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="tu_email@gmail.com"
MAIL_PASS="xxxx xxxx xxxx xxxx"
MAIL_DESTINATION="email_destino@gmail.com"

# Seguridad JWT — Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIAR_POR_STRING_ALEATORIO_DE_64_CARACTERES"
JWT_EXPIRES_IN="7d"

# CORS — debe ser la URL HTTPS pública del frontend en Railway
# Ejemplo: https://hastaup-frontend.up.railway.app
FRONTEND_URL="https://TU_FRONTEND.up.railway.app"

# Puerto — Railway lo inyecta automáticamente, NO definir manualmente
# PORT=3001
