// 1. Configuración del cliente y la base de datos
generator client {
  provider = "prisma-client-js"
}

// La URL de conexión se configura en prisma.config.ts (requerido por Prisma v7)
datasource db {
  provider = "postgresql"
}

// 2. Modelo de Usuario (Estructura rígida y segura)
model User {
  id                  String   @id @default(uuid())
  name                String
  lastName            String?  @default("")
  cuit                String?  @unique
  email               String   @unique
  password            String
  phone               String?  @default("")
  city                String?  @default("")
  state               String?  @default("")
  country             String?  @default("Argentina")
  avatarUrl           String?  @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=200")
  role                String   @default("USER") // "ADMIN" o "USER"
  favoritePropertyIds String[] @default([])
  savedEventIds       String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt @default(now())
}

// 3. Modelo de Inmueble (Estructura híbrida con JSONB)
model Property {
  id          String   @id @default(uuid())
  title       String
  description String?
  location    String
  price     Float
  currency  String   @default("USD")
  type      String   // "Venta" o "Alquiler"
  imageUrl  String           // Foto de portada (se muestra en cards y listados)
  images    String[]         // Galería adicional (se muestra en la página de detalle)
  details   Json?    // { bedrooms: number, bathrooms: number }
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

// 4. Modelo de Eventos / Subastas
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  time        String
  location    String
  category    String   @default("Subasta") // "Subasta", "Charla", "Capacitación", "Exhibición", "Evento"
  imageUrl    String
  images      String[]
  links       Json?    // [{ label: string, url: string }]
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}